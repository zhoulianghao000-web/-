{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pawday production admission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "updated_at",
    "owner_decision",
    "baseline_commit",
    "secret_references",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "pawday-production-admission/v1"
    },
    "stage": {
      "const": "M6.1"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "owner_decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "secret_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^secrets://pawday/production/[a-z0-9][a-z0-9/_-]{0,100}$"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "provider_decision",
        "source_files",
        "required_scenarios",
        "evidence",
        "blockers"
      ],
      "properties": {
        "id": {
          "enum": [
            "payment_refund",
            "settlement",
            "sms",
            "storage_media",
            "ai_live",
            "logistics_navigation",
            "operator_mfa",
            "privacy_delete",
            "backup_restore",
            "observability",
            "devices_security",
            "launch_data",
            "capacity_recovery",
            "infrastructure_security"
          ]
        },
        "status": {
          "enum": [
            "PENDING",
            "VERIFIED"
          ]
        },
        "provider_decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./-]+$"
          }
        },
        "required_scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_/-]+\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
