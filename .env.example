POSTGRES_DB=pawday
POSTGRES_USER=pawday
POSTGRES_PASSWORD=pawday_dev_only
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pawday
SPRING_DATASOURCE_USERNAME=pawday
SPRING_DATASOURCE_PASSWORD=pawday_dev_only
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=pawday
RABBITMQ_PASSWORD=pawday_dev_only
OPENSEARCH_URL=http://localhost:9200

# Required stable 32-byte Base64 key; supply via environment/secret manager.
PAWDAY_AUTH_SECRET=REPLACE_WITH_BASE64_32_RANDOM_BYTES
PAWDAY_DEMO_ENABLED=false
PAWDAY_LOCAL_SMS_ENABLED=false
# Spring does not automatically load this file; scripts load .env.local.

PAWDAY_STORAGE_LOCAL_ROOT=.local-media
PAWDAY_SEARCH_ENABLED=true
PAWDAY_SEARCH_CONSUMERS_ENABLED=true
PAWDAY_SEARCH_WORKERS_ENABLED=true
