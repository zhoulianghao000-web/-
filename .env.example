POSTGRES_DB=pawday
POSTGRES_USER=pawday
POSTGRES_PASSWORD=pawday_dev_only
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pawday
SPRING_DATASOURCE_USERNAME=pawday
SPRING_DATASOURCE_PASSWORD=pawday_dev_only
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=pawday
RABBITMQ_PASSWORD=pawday_dev_only
OPENSEARCH_URL=http://localhost:9200

# Required stable 32-byte Base64 key; supply via environment/secret manager.
PAWDAY_AUTH_SECRET=REPLACE_WITH_BASE64_32_RANDOM_BYTES
PAWDAY_DEMO_ENABLED=false
PAWDAY_LOCAL_SMS_ENABLED=false
# Spring does not automatically load this file; scripts load .env.local.

PAWDAY_STORAGE_LOCAL_ROOT=.local-media
PAWDAY_SEARCH_ENABLED=true
PAWDAY_SEARCH_CONSUMERS_ENABLED=true
PAWDAY_SEARCH_WORKERS_ENABLED=true

# Explicit non-production service rehearsal only; never enables real partner/payment authority.
PAWDAY_BOOKING_SIMULATION_ENABLED=false
PAWDAY_SERVICE_TRADE_SIMULATION_ENABLED=false

# Service synthetic finance recovery; still requires all simulation/provider/non-production gates.
PAWDAY_SERVICE_TRADE_FINANCE_RECOVERY_ENABLED=true

# Optional server-only synthetic service fixture; never a client outcome or a real payment.
# Non-PENDING values require both booking and service simulation in non-production.
PAWDAY_SERVICE_TRADE_FIXTURE_OUTCOME=PENDING

# V3.2-B1 synthetic inventory only. No real provider credentials or endpoints.
PAWDAY_ERP_WMS_SIMULATION_ENABLED=false
PAWDAY_ERP_WMS_PROVIDER=SIMULATED_TEST
# EMPTY (default) or explicit server-only TEST_REPLENISH_10 for isolated development.
PAWDAY_ERP_WMS_FIXTURE_SCENARIO=EMPTY

# V3.2-B2 server fixture only: EMPTY(default), TEST_ACCEPTED, TEST_REJECTED,
# TEST_UNKNOWN, TEST_RESPONSE_LOST. Explicit non-production simulation required.
PAWDAY_ERP_WMS_DELIVERY_SCENARIO=EMPTY
